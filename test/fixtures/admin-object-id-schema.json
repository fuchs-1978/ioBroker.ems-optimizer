{
  "$comment": "Unmodified definitions from the official ioBroker Admin JSON schema; pins the objectId/customFilter contract relevant to output selectors and the state property contract for read-only status widgets.",
  "source": {
    "url": "https://github.com/ioBroker/ioBroker.admin/blob/master/packages/jsonConfig/schemas/jsonConfig.json",
    "blobSha": "d3eb132c450fb49833076fc4231de1520e2e7a0f",
    "retrieved": "2026-10-04"
  },
  "definitions": {
    "customFilter": {
      "type": "object",
      "description": "JSON schema for the ObjectBrowserCustomFilter interface from TypeScript.\n\nNote: ioBroker-specific enums (e.g., ObjectType, CommonType) are allowed here as strings or arrays of strings; typical values are mentioned in the description.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Object type(s) in Object Browser, e.g., 'state', 'channel', 'device'. Can be a string or an array of strings.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "state",
                "channel",
                "device",
                "folder",
                "meta",
                "adapter",
                "instance",
                "host",
                "enum",
                "group",
                "user",
                "script",
                "chart",
                "schedule"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "state",
                  "channel",
                  "device",
                  "folder",
                  "meta",
                  "adapter",
                  "instance",
                  "host",
                  "enum",
                  "group",
                  "user",
                  "script",
                  "chart",
                  "schedule"
                ]
              },
              "minItems": 1
            }
          ]
        },
        "common": {
          "description": "Filter on common.* properties of the object (e.g., type, role, custom)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "Data type of the state, e.g., 'number', 'string', 'boolean', 'object', 'array', 'mixed'. Accepts string or array of strings.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "number",
                    "string",
                    "boolean",
                    "object",
                    "array",
                    "mixed"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "number",
                      "string",
                      "boolean",
                      "object",
                      "array",
                      "mixed"
                    ]
                  },
                  "minItems": 1
                }
              ]
            },
            "role": {
              "description": "Role(s) of the state, e.g., 'switch', 'button' or beginning of roles. String or array of strings.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "custom": {
              "description": "Special filter for common.custom:\n- \"_\" => no custom set (literal underscore)\n- \"_dataSources\" => only data sources (history/sql/influx etc.)\n- true => any non-empty custom\n- \"adapter.\" or \"adapter.0\" or general string => specific custom (or prefix)\nAccepts: boolean true, string or array of strings.",
              "oneOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            }
          }
        }
      }
    },
    "objectIdProps": {
      "type": "object",
      "properties": {
        "types": {
          "description": "Filter for one of the possible types: 'channel', 'device', ... (is state by default)",
          "oneOf": [
            {
              "default": "state",
              "type": "string",
              "enum": [
                "state",
                "channel",
                "device",
                "enum",
                "host",
                "adapter",
                "instance",
                "meta",
                "config",
                "script",
                "user",
                "group",
                "chart",
                "folder"
              ]
            },
            {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "state",
                  "channel",
                  "device",
                  "enum",
                  "host",
                  "adapter",
                  "instance",
                  "meta",
                  "config",
                  "script",
                  "user",
                  "group",
                  "chart",
                  "folder"
                ]
              }
            }
          ]
        },
        "root": {
          "description": "Show only this root object and its children",
          "type": "string"
        },
        "customFilter": {
          "description": "Cannot be used together with `types` settings. Example: `{type: ['channel', 'device']}` - show only channels and devices",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/customFilter"
            }
          ]
        },
        "filterFunc": {
          "description": "Cannot be used together with `types` settings. It is a function that will be called for every object and must return true or false. Example: `obj.common.type === 'number'`",
          "type": "string"
        },
        "fillOnSelect": {
          "description": "Fill other config fields when an object ID is selected. Format: 'pathInObject=>attr,pathInObject=>attr(X)'. Example: 'common.name=>name,common.color=>color(X)'. Append '(X)' to overwrite non-empty fields.",
          "type": "string"
        },
        "placeholder": {
          "description": "Placeholder (for text control)",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "label": true,
        "type": true,
        "defaultSendTo": true,
        "allowSaveWithError": true,
        "xs": true,
        "sm": true,
        "md": true,
        "lg": true,
        "xl": true,
        "newLine": true,
        "hidden": true,
        "dependsOnStates": true,
        "debug": true,
        "os": true,
        "notOs": true,
        "docker": true,
        "hideOnlyControl": true,
        "disabled": true,
        "helpLink": true,
        "help": true,
        "style": true,
        "darkStyle": true,
        "validator": true,
        "validatorNoSaveOnError": true,
        "validatorErrorText": true,
        "noMultiEdit": true,
        "tooltip": true,
        "expertMode": true,
        "default": true,
        "defaultFunc": true,
        "onChange": true,
        "noTranslation": true,
        "confirm": true,
        "filters": {
          "description": "Predefined search filters",
          "type": "object"
        },
        "doNotSave": true,
        "button": true,
        "buttonTooltip": true,
        "buttonTooltipNoTranslation": true,
        "data": true,
        "jsonData": true
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "multilingual": {
      "type": "object",
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^(de|ru|pt|nl|fr|it|es|pl|uk|zh-cn)$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stateProps": {
      "type": "object",
      "properties": {
        "oid": {
          "description": "Which object ID should be taken for the controlling. The ID is without \"adapter.X.\" prefix",
          "type": "string"
        },
        "system": {
          "description": "IF true, the state will be taken from system.adapter.XX.I. and not from XX.I",
          "type": "boolean"
        },
        "control": {
          "description": "How the value of the state should be shown",
          "type": "string",
          "enum": [
            "text",
            "html",
            "input",
            "number",
            "slider",
            "switch",
            "select",
            "button"
          ]
        },
        "controlled": {
          "description": "If false, the control will be read only",
          "type": "boolean"
        },
        "unit": {
          "description": "Unit (could be multi-language)",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "trueText": {
          "description": "This text will be shown if the value is true",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "trueTextStyle": {
          "description": "Style of the text if the value is true",
          "type": "object"
        },
        "falseText": {
          "description": "This text will be shown if the value is false",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "falseTextStyle": {
          "description": "Style of the text if the value is false",
          "type": "object"
        },
        "trueImage": {
          "description": "This image will be shown if the value is true. It could be base64 or URL",
          "type": "string"
        },
        "falseImage": {
          "description": "This image will be shown if the value is false. It could be base64 or URL",
          "type": "string"
        },
        "min": {
          "description": "Minimum value for number or slider",
          "type": "number"
        },
        "max": {
          "description": "Maximum value for number or slider",
          "type": "number"
        },
        "step": {
          "description": "Step for number or slider",
          "type": "number"
        },
        "controlDelay": {
          "description": "Delay in ms between the change and the command",
          "type": "number"
        },
        "variant": {
          "description": "Show spinner while request is in progress",
          "type": "string",
          "enum": [
            "contained",
            "outlined",
            "text"
          ]
        },
        "readOnly": {
          "description": "Defines if the control is read-only. Applied only to 'input', 'slider', 'select', 'button', 'switch', 'number'",
          "type": "boolean"
        },
        "foreign": {
          "description": "The 'oid' is absolute and no need to add 'adapter.X' or 'system.adapter.X.' to oid",
          "type": "boolean"
        },
        "narrow": {
          "description": "With this flag, the value will appear just after the label",
          "type": "boolean"
        },
        "blinkOnUpdate": {
          "description": "Value should blink when updated (true or color). Only texts",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "size": {
          "description": "Font size: small, normal, large or number",
          "oneOf": [
            {
              "default": "normal",
              "type": "string",
              "enum": [
                "small",
                "normal",
                "large"
              ]
            },
            {
              "type": "number"
            }
          ]
        },
        "addColon": {
          "description": "Add to label the colon at the end if not exist in label",
          "type": "boolean"
        },
        "labelIcon": {
          "description": "Base64 icon for label",
          "type": "string"
        },
        "buttonValue": {
          "description": "Optional value, that will be sent for button",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "showEnterButton": {
          "description": "Show SET button. The value in this case will be sent only when the button is pressed. You can define the text of the button. Default text is \"Set\" (Only for \"input\", \"number\" or \"slider\")",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "setOnEnterKey": {
          "description": "The value in this case will be sent only when the \"Enter\" button is pressed. It can be combined with `showEnterButton`",
          "type": "boolean"
        },
        "digits": {
          "description": "Number of decimal places to display for numeric values in text/html mode",
          "type": "number",
          "minimum": 0
        },
        "ack": {
          "description": "Write the value as acknowledged. By default, the control writes a command (`false`), so that the adapter reacts to it",
          "type": "boolean"
        },
        "highlight": {
          "description": "Highlight the line on mouse over",
          "type": "boolean"
        },
        "options": {
          "description": "Options for `select` in form `[\"value1\", \"value2\", ...]` or `[{\"value\": \"value\", \"label\": \"Value1\"}, \"value2\", ...]`. If not defiled, the `common.states` in the object must exist.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/selectOption"
              },
              {
                "$ref": "#/definitions/selectOptionGroup"
              }
            ]
          }
        },
        "label": true,
        "type": true,
        "xs": true,
        "sm": true,
        "md": true,
        "lg": true,
        "xl": true,
        "newLine": true,
        "hidden": true,
        "dependsOnStates": true,
        "debug": true,
        "os": true,
        "notOs": true,
        "docker": true,
        "hideOnlyControl": true,
        "disabled": true,
        "helpLink": true,
        "help": true,
        "style": true,
        "darkStyle": true,
        "tooltip": true,
        "expertMode": true,
        "noTranslation": true,
        "confirm": true,
        "defaultSendTo": true,
        "allowSaveWithError": true,
        "validator": true,
        "validatorNoSaveOnError": true,
        "validatorErrorText": true,
        "noMultiEdit": true,
        "default": true,
        "defaultFunc": true,
        "onChange": true,
        "doNotSave": true,
        "button": true,
        "buttonTooltip": true,
        "buttonTooltipNoTranslation": true,
        "data": true,
        "jsonData": true
      },
      "additionalProperties": false,
      "required": [
        "type",
        "oid"
      ]
    },
    "selectOption": {
      "type": "object",
      "description": "A single selectable option of a `select` control.",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "description": "Label of the option",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "value": {
          "description": "Value of the option"
        },
        "hidden": {
          "description": "Boolean or JS formula (may use `native.attribute`) to show or hide the option",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "os": {
          "$ref": "#/definitions/osFilter"
        },
        "notOs": {
          "$ref": "#/definitions/notOsFilter"
        },
        "docker": {
          "description": "Show this element only if the ioBroker runs (`true`) or does not run (`false`) in a docker container. If the docker state cannot be detected, the element will be shown.",
          "type": "boolean"
        },
        "group": {
          "description": "Is it a group or not",
          "type": "boolean"
        },
        "color": {
          "description": "Color of the option",
          "type": "string"
        },
        "description": {
          "description": "Description for the value, shown below the label",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "icon": {
          "description": "Icon URL to display next to the option",
          "type": "string"
        },
        "noTranslation": {
          "description": "Do not translate this one option",
          "type": "boolean"
        }
      }
    },
    "osFilter": {
      "description": "Show this element only on the given operating system(s) of the host, on which the instance runs, e.g. `win32` or `[\"linux\", \"darwin\"]`. If the operating system cannot be detected, the element will be shown.",
      "oneOf": [
        {
          "$ref": "#/definitions/osName"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/osName"
          }
        }
      ]
    },
    "osName": {
      "type": "string",
      "description": "Operating system of the host (node.js `process.platform`)",
      "enum": [
        "aix",
        "android",
        "cygwin",
        "darwin",
        "freebsd",
        "haiku",
        "linux",
        "netbsd",
        "openbsd",
        "sunos",
        "win32"
      ]
    },
    "notOsFilter": {
      "description": "Do not show this element on the given operating system(s) of the host, on which the instance runs, e.g. `win32` or `[\"linux\", \"darwin\"]`. If the operating system cannot be detected, the element will be shown.",
      "oneOf": [
        {
          "$ref": "#/definitions/osName"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/osName"
          }
        }
      ]
    },
    "selectOptionGroup": {
      "type": "object",
      "description": "A group of select options. `value` is not required when `items` are provided.",
      "additionalProperties": false,
      "required": [
        "label",
        "items"
      ],
      "properties": {
        "label": {
          "description": "Label of the group",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "value": {
          "description": "Optional value of the group header"
        },
        "hidden": {
          "description": "Boolean or JS formula (may use `native.attribute`) to show or hide the group",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "os": {
          "$ref": "#/definitions/osFilter"
        },
        "notOs": {
          "$ref": "#/definitions/notOsFilter"
        },
        "docker": {
          "description": "Show this element only if the ioBroker runs (`true`) or does not run (`false`) in a docker container. If the docker state cannot be detected, the element will be shown.",
          "type": "boolean"
        },
        "color": {
          "description": "Color of the group",
          "type": "string"
        },
        "description": {
          "description": "Description for the group, shown below the label",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/multilingual"
            }
          ]
        },
        "icon": {
          "description": "Icon URL to display next to the group",
          "type": "string"
        },
        "noTranslation": {
          "description": "Do not translate this one option",
          "type": "boolean"
        },
        "items": {
          "description": "Sub-options of this group",
          "type": "array",
          "items": {
            "$ref": "#/definitions/selectOption"
          }
        }
      }
    }
  }
}
