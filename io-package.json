    "news": {
      "0.17.0-alpha.252": {
        "en": "Optionally charge the Mii at night using CHP surplus and a 10-point battery SoC band.",
        "de": "Mii nachts optional aus BHKW-Überschuss und einem Speicherfenster von 10 SoC-Punkten laden.",
        "es": "Carga nocturna opcional del Mii con excedente de cogeneración y una banda de 10 puntos de carga de batería.",
        "fr": "Recharge nocturne optionnelle du Mii avec surplus de cogénération et une plage de 10 points de charge.",
        "it": "Ricarica notturna opzionale della Mii con surplus di cogenerazione e una fascia di 10 punti di carica.",
        "nl": "Laad de Mii optioneel ’s nachts met WKK-overschot en een accubereik van 10 procentpunten.",
        "pl": "Opcjonalne nocne ładowanie Mii z nadwyżki kogeneracji i zakresu 10 punktów naładowania.",
        "pt": "Carregamento noturno opcional do Mii com excedente de cogeração e uma faixa de 10 pontos de carga.",
        "ru": "Опциональная ночная зарядка Mii избытком когенерации и 10 процентными пунктами заряда накопителя.",
        "uk": "Додаткове нічне заряджання Mii надлишком когенерації та в діапазоні 10 відсоткових пунктів заряду.",
        "zh-cn": "可在夜间用热电联产余电和储能电池 10 个百分点的电量区间为 Mii 充电。"
      },
      "0.17.0-alpha.251": {
        "en": "Resume a SunEnergy direction change after a confirmed zero command and measured standstill.",
        "de": "SunEnergy-Richtungswechsel nach bestätigtem Nullbefehl und gemessenem Stillstand fortsetzen.",
        "es": "Reanuda el cambio de sentido tras confirmar la orden de cero y la parada medida.",
        "fr": "Reprend le changement de sens après confirmation de la consigne zéro et de l’arrêt mesuré.",
        "it": "Riprende il cambio di direzione dopo la conferma del comando zero e dell’arresto misurato.",
        "nl": "Hervat de richtingswissel na een bevestigd nulcommando en gemeten stilstand.",
        "pl": "Wznawia zmianę kierunku po potwierdzeniu polecenia zerowego i zmierzeniu zatrzymania.",
        "pt": "Retoma a mudança de direção após a confirmação do comando zero e da paragem medida.",
        "ru": "Продолжает смену направления после подтверждения нулевой команды и измеренной остановки.",
        "uk": "Продовжує зміну напрямку після підтвердження нульової команди та виміряної зупинки.",
        "zh-cn": "确认零功率指令并测得停止后继续切换 SunEnergy 方向。"
      },
      "0.17.0-alpha.250": {
        "en": "Reduce an acknowledged SunEnergy discharge while AC power is still settling, including household discharge.",
        "de": "Bestätigten SunEnergy-Entladeauftrag auch bei der Haushaltsentladung direkt reduzieren.",
        "es": "Reduce la descarga confirmada de SunEnergy también para el consumo del hogar.",
        "fr": "Réduit la décharge SunEnergy confirmée également pour la consommation du foyer.",
        "it": "Riduce la scarica SunEnergy confermata anche per i consumi domestici.",
        "nl": "Verlaagt een bevestigde SunEnergy-ontlading ook bij huishoudelijk verbruik.",
        "pl": "Zmniejsza potwierdzone rozładowanie SunEnergy także na potrzeby domu.",
        "pt": "Reduz a descarga confirmada da SunEnergy também para o consumo doméstico.",
        "ru": "Снижает подтверждённую мощность разряда SunEnergy и для бытовой нагрузки.",
        "uk": "Зменшує підтверджену потужність розряду SunEnergy також для побутового навантаження.",
        "zh-cn": "家庭用电时也可直接降低已确认的 SunEnergy 放电功率。"
      },
      "0.17.0-alpha.249": {
        "en": "Reduce acknowledged SunEnergy discharge directly while buffering a wallbox.",
        "de": "Bestätigten SunEnergy-Entladeauftrag beim Wallbox-Puffern direkt reduzieren.",
        "es": "Reduce directamente la descarga confirmada de SunEnergy durante el apoyo a la estación de carga.",
        "fr": "Réduit directement la décharge SunEnergy confirmée pendant le soutien à la borne.",
        "it": "Riduce direttamente la scarica SunEnergy confermata durante il supporto alla wallbox.",
        "nl": "Verlaagt een bevestigde SunEnergy-ontlading direct bij ondersteuning van de laadpaal.",
        "pl": "Zmniejsza potwierdzone rozładowanie SunEnergy bezpośrednio podczas wspomagania ładowarki.",
        "pt": "Reduz diretamente a descarga confirmada da SunEnergy durante o apoio ao carregador.",
        "ru": "Снижает подтверждённую мощность разряда SunEnergy при поддержке зарядной станции.",
        "uk": "Зменшує підтверджену потужність розряду SunEnergy під час підтримки зарядної станції.",
        "zh-cn": "在为充电桩提供缓冲时直接降低已确认的 SunEnergy 放电功率。"
      },
      "0.17.0-alpha.248": {
        "en": "Automatically release an old SunEnergy command after repeated fresh zero feedback.",
        "de": "SunEnergy-Altauftrag nach wiederholter frischer Nullrückmeldung automatisch freigeben.",
        "es": "Libera automáticamente la orden antigua tras varias lecturas nuevas de cero.",
        "fr": "Libère automatiquement l’ancienne commande après plusieurs mesures récentes à zéro.",
        "it": "Rilascia automaticamente il comando precedente dopo nuove letture a zero.",
        "nl": "Geeft een oude opdracht automatisch vrij na meerdere nieuwe nulmetingen.",
        "pl": "Automatycznie zwalnia stare polecenie po kolejnych świeżych odczytach zera.",
        "pt": "Liberta automaticamente o comando antigo após novas leituras de zero.",
        "ru": "Автоматически снимает старую команду после повторных новых показаний нуля.",
        "uk": "Автоматично знімає стару команду після повторних свіжих нульових показань.",
        "zh-cn": "收到多次新的零功率反馈后自动释放旧指令。"
      },
      "0.17.0-alpha.247": {
        "en": "Bridge a PV shortfall during the wallbox stop delay with SunEnergy storage.",
        "de": "PV-Fehlbetrag während der Wallbox-Ausschaltverzögerung mit dem SunEnergy-Speicher überbrücken.",
        "es": "Cubre el déficit solar durante el retardo de parada con SunEnergy.",
        "fr": "Compense le déficit solaire pendant le délai d’arrêt avec SunEnergy.",
        "it": "Compensa il deficit solare durante il ritardo di arresto con SunEnergy.",
        "nl": "Overbrugt PV-tekort tijdens de uitschakelvertraging met SunEnergy.",
        "pl": "Pokrywa niedobór PV podczas opóźnienia wyłączenia z SunEnergy.",
        "pt": "Compensa o défice solar durante o atraso de desligamento com SunEnergy.",
        "ru": "Компенсирует дефицит ФЭМ во время задержки отключения с SunEnergy.",
        "uk": "Компенсує дефіцит ФЕМ під час затримки вимкнення із SunEnergy.",
        "zh-cn": "在充电桩停止延迟期间使用 SunEnergy 补足光伏缺口。"
      },
      "0.17.0-alpha.246": {
        "en": "Resume confirmed SunEnergy charging and discharging after a normal restart.",
        "de": "Bestätigtes SunEnergy-Laden und -Entladen nach regulärem Neustart übernehmen.",
        "es": "Retoma la carga y descarga SunEnergy confirmadas tras reiniciar.",
        "fr": "Reprend la charge et la décharge SunEnergy confirmées après redémarrage.",
        "it": "Riprende carica e scarica SunEnergy confermate dopo il riavvio.",
        "nl": "Hervat bevestigd laden en ontladen van SunEnergy na herstart.",
        "pl": "Wznawia potwierdzone ładowanie i rozładowanie SunEnergy po restarcie.",
        "pt": "Retoma a carga e descarga SunEnergy confirmadas após reiniciar.",
        "ru": "Возобновляет подтверждённый заряд и разряд SunEnergy после перезапуска.",
