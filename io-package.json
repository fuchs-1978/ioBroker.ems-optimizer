{
  "common": {
    "name": "ems-optimizer",
    "version": "0.17.0-alpha.136",
    "stopTimeout": 10000,
    "news": {
      "0.17.0-alpha.136": {
        "en": "Reserve independent episode slots for export, deviations and gaps; keep category-specific drop counters and prioritize relevant cases under the 64 kB limit.",
        "de": "Getrennte Speicherplaetze fuer Einspeisung, Abweichungen und Luecken; Verdraengungen je Kategorie ausweisen und wichtige Faelle unter der 64-kB-Grenze erhalten."
      },
      "0.17.0-alpha.135": {
        "en": "Honor explicit manual wallbox minimum current without a valid forecast plan, retaining live source, release, SOC and protection gates.",
        "de": "Expliziten manuellen Wallbox-Mindeststrom auch ohne gueltigen Fahrplan ausfuehren; aktuelle Quellen, Freigaben, Ziel-SoC und Schutzgrenzen bleiben massgeblich."
      },
      "0.17.0-alpha.134": {
        "en": "Retain confirmed charging through fresh-feedback recovery before the parallel allocator refreshes an own-power age rejection; preserve safety gates and reservations.",
        "de": "Bestaetigte Ladung bei frischer Rueckmeldung vor Erneuerung einer allein altersbedingt ungueltigen Parallelzuteilung halten; Schutzpruefungen und Reserven bleiben erhalten."
      },
      "0.17.0-alpha.133": {
        "en": "Add time-stamped investigation episodes for sustained export, grid-target deviation and source gaps to compact daily summaries.",
        "de": "Zeitlich markierte Untersuchungsfenster fuer laengere Einspeisung, NVP-Sollabweichung und Quellenluecken in der kompakten Tagesbilanz."
      },
      "0.17.0-alpha.132": {
        "en": "Add bounded passive daily energy and coverage summaries with restart-safe checkpoints; no SQL scans or actuator changes.",
        "de": "Kompakte passive Tagesbilanzen mit Energie, Datenabdeckung und neustartfestem Pruefstand; keine SQL-Vollabrufe oder Aktoraenderungen."
      },
      "0.17.0-alpha.131": {
        "en": "Observe coherent delayed go-e current polls for up to 10 seconds with live protection checks and full reservations before stopping.",
        "de": "Zusammenpassende verspaetete go-e-Sollstrommeldungen bis zu 10 Sekunden beruhigen lassen; laufende Schutzpruefungen und volle Reserven bleiben aktiv."
      },
      "0.17.0-alpha.130": {
        "en": "Prefer a small grid import: migrate neutral targets once to 50 W and allow physically funded one-amp PV steps beyond the nominal soft conversion, retaining full hard reservations.",
        "de": "Kleinen Netzbezug bevorzugen: neutralen Sollwert einmalig auf 50 W umstellen und messtechnisch gedeckte 1-A-PV-Schritte trotz nominaler Umrechnung zulassen; harte Leistungsreserven bleiben erhalten."
      }
    },
    "titleLang": {
      "en": "EMS Optimizer",
      "de": "EMS-Optimierer"
    },
    "desc": {
      "en": "Forecast-based energy management observer",
      "de": "Prognosebasierter Energiemanagement-Beobachter"
    },
    "authors": [
      "fuchs-1978"
    ],
    "licenseInformation": {
